+py::dict Atlas::generateProfile(xatlas::ChartOptions const& chartOptions, xatlas::PackOptions const& packOptions)
+{
+    using Clock = std::chrono::steady_clock;
+    double charts, packing;
+    {
+        py::gil_scoped_release release;
+        auto begin = Clock::now();
+        xatlas::ComputeCharts(m_atlas, chartOptions);
+        auto split = Clock::now();
+        xatlas::PackCharts(m_atlas, packOptions);
+        auto end = Clock::now();
+        charts = std::chrono::duration<double>(split - begin).count();
+        packing = std::chrono::duration<double>(end - split).count();
+    }
+    py::dict result;
+    result["computeChartsSeconds"] = charts;
+    result["packChartsSeconds"] = packing;
+    return result;
+}
